# Copiar este archivo a .env y completar con tu API key real.
# NUNCA subir el .env real a GitHub.

GEMINI_API_KEY=tu_api_key_aqui

# Modelo de generación (explicación final)
GEMINI_MODEL=gemini-2.5-flash

# Modelo de embeddings
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Opcional: token de Hugging Face, solo ayuda a evitar límites de descarga
# al bajar el modelo de sentence-transformers la primera vez. El modelo es
# público, no es obligatorio tenerlo.
HF_TOKEN=
